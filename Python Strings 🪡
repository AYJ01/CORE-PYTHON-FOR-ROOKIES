
# In Python, strings are enclosed by either single (') or double (") quotation marks. A string can include various forms of #data:
# Text: "Hello, world!"
# Numbers as Text: "12345"
# Special Characters: "!@#$%^&*()"
# Whitespace: " " (three spaces)
# Empty String: "" or ''
# Multi-line Text: Enclosed in triple quotes (''' or """)
# Combination of Different Characters: "Python3 is fun!"
# Note: Strings can represent any sequence of characters within quotes, with exceptions for escape sequences and the quotes #themselves when used within the string. Both single and double quotes can be utilized to enclose strings.

string1 = "Programming is learned by writing programs"

string2 = "1234567890"

string3 = "!@#$%^&*()_-+="

print(string1)

